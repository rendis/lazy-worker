{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lazy Worker",
  "version": "0.6.5",
  "identifier": "com.rendis.lazyworker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lazy Worker",
        "width": 1040,
        "height": 640,
        "minWidth": 1040,
        "minHeight": 640,
        "maxWidth": 1040,
        "maxHeight": 640,
        "resizable": false,
        "maximizable": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 26 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "resources": { "../LICENSE": "LICENSE" },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
